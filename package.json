{
  "name": "verity",
  "version": "1.0.0",
  "private": true,
  "description": "Check a download's checksum in your browser: MD5, SHA-1, SHA-256, SHA-512 and CRC32 in WebAssembly.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "asbuild": "asc assembly/index.ts --outFile public/verity.wasm --optimize --runtime stub --noAssert --initialMemory 80",
    "dev": "npm run asbuild && vite",
    "build": "npm run asbuild && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run asbuild && npm run asbuild:testing && vitest run",
    "constants": "node scripts/gen-constants.mjs",
    "asbuild:testing": "asc assembly/testing.ts --outFile build/testing.wasm --runtime stub --noAssert",
    "bench": "npm run asbuild && node scripts/bench.mjs",
    "lint": "oxlint --deny-warnings"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "assemblyscript": "^0.28.20",
    "oxlint": "^1.95.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  }
}
