{
  "name": "verity",
  "version": "1.0.0",
  "private": true,
  "description": "Check a download's checksum or hash in your browser: SHA-256, SHA-512, SHA-1, MD5 and CRC32, computed in WebAssembly. Nothing is uploaded.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iSquare-Lab/verity"
  },
  "homepage": "https://github.com/iSquare-Lab/verity",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26"
  },
  "scripts": {
    "dev": "npm run asbuild && vite",
    "build": "npm run asbuild && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run asbuild && npm run asbuild:testing && vitest run",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "asbuild": "asc assembly/index.ts --outFile public/verity.wasm --optimize --runtime stub --noAssert --initialMemory 80",
    "asbuild:testing": "asc assembly/testing.ts --outFile build/testing.wasm --runtime stub --noAssert",
    "bench": "npm run asbuild && node scripts/bench.mjs",
    "constants": "node scripts/gen-constants.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "assemblyscript": "^0.28.20",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.95.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  }
}
